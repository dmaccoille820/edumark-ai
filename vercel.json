{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/proxy"
    },
    {
      "source": "/api-proxy/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/api-proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}